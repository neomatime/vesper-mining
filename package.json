{
  "name": "vesper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @vesper/mine-operator build",
    "dev": "pnpm --filter @vesper/mine-operator dev",
    "lint": "pnpm --filter @vesper/mine-operator lint",
    "test": "pnpm --filter @vesper/mine-operator test",
    "test:e2e": "pnpm --filter @vesper/mine-operator test:e2e",
    "typecheck": "pnpm --filter @vesper/api-contracts typecheck && pnpm --filter @vesper/mine-operator typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
