# VESPER mine-operator settings. Copy to .env.local for local work; set the same names in Vercel for deployments.
# Every setting is optional: VESPER works without them.

# Google Maps for delivery planning (place search, exact points and driving routes).
# Leave empty to use VESPER's own place list, pins on the map, typed coordinates and route estimates.
# The key needs the Maps JavaScript API, Places API (New), Geocoding API and Routes API, restricted to the VESPER domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# An approved map tile provider for the delivery maps (optional). Without it VESPER draws its own base map.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
