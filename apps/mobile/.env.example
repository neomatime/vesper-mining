# VESPER Mobile settings. Copy to .env.local for local work; set the same names in Vercel for deployments.

# Where Mining Operations lives, for "Open VESPER on the web" and links to records that live there.
# Locally it is http://127.0.0.1:3000 without this setting; in a deployment, leave empty to hide those links.
NEXT_PUBLIC_OPERATIONS_URL=
